#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2009-2014 Stephan Raue (stephan@openelec.tv)

StartProgressLog() {
  if [ "$1" = "spinner" ]; then
    echo "*** $3" >>$LOG
  fi
  StartProgress "$@"
}

if [ -e /storage/.please_resize_me ] ; then
  . /usr/lib/rocknix/functions

  hidecursor

  mount -o remount,rw /flash
  LOG=/flash/fs-resize.log
  date -Iseconds >>$LOG

  # resize_storage_<size>G on /flash caps the storage partition at <size> and
  # gives the remaining space to a new exFAT GAMES partition (largest cap wins)
  TARGET_SIZE=$(ls /flash/resize_storage_*G 2>/dev/null | sed -e 's#.*resize_storage_##' | grep -E '^[0-9]+G$' | sort -V | tail -n 1)

  # this sh** was never intended to be used
  # on already installed and runing system
  if [ -d /storage/.config -o -d /storage/.cache ] ; then
    rm -f /storage/.please_resize_me
    sync
    echo "Resizing is not permitted - the system has already been initialised." | tee -a $LOG
    mount -o remount,ro /flash
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
    reboot -f
  fi

  # get the disk. /storage on 2nd partition
  echo $(grep "/storage " /proc/mounts) >>$LOG
  PART=$(grep "/storage " /proc/mounts | cut -d" " -f1 | grep '[0-9]$')
  PARTNUM="${PART: -1}"

  # get disk: /dev/sdx2 -> /dev/sdx, /dev/mmcblkxp2 -> /dev/mmcblkx
  case $PART in
    "/dev/mmcblk"*|"/dev/nvme"*)
      DISK=$(echo $PART | sed s/p[0-9]$//g)
      ;;
    *)
      DISK=$(echo $PART | sed s/[0-9]$//g)
      ;;
  esac

  rm -f /storage/.please_resize_me
  sync

  echo "DISK: $DISK  PART: $PART" >>$LOG

  # just in case
  if [ ! -z "$DISK" -a ! -z "$PART" ] ; then
    # fall back to a full resize if the disk cannot fit the requested cap
    if [ -n "$TARGET_SIZE" ] ; then
      DISK_BYTES=$(blockdev --getsize64 "$DISK" 2>/dev/null) || DISK_BYTES=0
      TARGET_GIB=${TARGET_SIZE%G}
      if awk -v b="$DISK_BYTES" -v gib="$TARGET_GIB" 'BEGIN { exit ((b + 0) > gib * 1024 * 1024 * 1024) ? 0 : 1 }' ; then
        :
      else
        echo "resize_storage: disk too small for ${TARGET_SIZE}; resizing storage to maximum size." | tee -a $LOG
        TARGET_SIZE=
        rm -f /flash/resize_storage_*
      fi
    fi

    umount $PART

    echo "PARTITION RESIZING IN PROGRESS"
    echo ""
    echo "Please do not reboot or turn off your @DISTRONAME@ device!"
    echo ""

    if [ -n "$TARGET_SIZE" ] ; then
      StartProgressLog spinner "Resizing storage partition to ${TARGET_SIZE}...   " "parted -s -f -m $DISK resizepart $PARTNUM ${TARGET_SIZE} >>$LOG 2>&1"
    else
      StartProgressLog spinner "Resizing partition...   " "parted -s -f -m $DISK resizepart $PARTNUM 100% >>$LOG 2>&1"
    fi

    StartProgressLog spinner "Checking file system... " "e2fsck -f -p $PART >>$LOG 2>&1"
    StartProgressLog spinner "Resizing file system... " "resize2fs $PART >>$LOG 2>&1"

    if [ -n "$TARGET_SIZE" ] ; then
      GAME_PARTNUM=$((PARTNUM + 1))
      case $PART in
        "/dev/mmcblk"*|"/dev/nvme"*)
          GAME_PART="${DISK}p${GAME_PARTNUM}"
          ;;
        *)
          GAME_PART="${DISK}${GAME_PARTNUM}"
          ;;
      esac
      if [ -b "${GAME_PART}" ] ; then
        # don't clobber a GAMES partition left behind by an interrupted resize
        if ! blkid "${GAME_PART}" >/dev/null 2>&1 ; then
          StartProgressLog spinner "Formatting GAMES partition as exFAT... " "mkfs.exfat -n GAMES ${GAME_PART} >>$LOG 2>&1"
        fi
      else
        StartProgressLog spinner "Creating GAMES partition...    " "parted -s -a optimal -m $DISK mkpart primary fat32 ${TARGET_SIZE} 100% >>$LOG 2>&1"
        StartProgressLog spinner "Formatting GAMES partition as exFAT... " "mkfs.exfat -n GAMES ${GAME_PART} >>$LOG 2>&1"
      fi
      echo "Created GAMES partition on ${GAME_PART}" >>$LOG
      rm -f /flash/resize_storage_*
    fi

    StartProgressLog spinner "Regenerating UUIDs...   " "tune2fs $PART -U random >>$LOG 2>&1; fatlabel -i -r ${DISK}p1 >>$LOG 2>&1"
    StartProgressLog spinner "Syncing to disk...      " "sync >>$LOG 2>&1"
    StartProgress countdown "Rebooting in 5s...     " 5 "NOW"
  else
    echo "Partition was not detected - resizing aborted."
    StartProgress countdown "Rebooting in 5s... " 5 "NOW"
  fi
  mount -o remount,ro /flash
fi
reboot -f &>/dev/null
