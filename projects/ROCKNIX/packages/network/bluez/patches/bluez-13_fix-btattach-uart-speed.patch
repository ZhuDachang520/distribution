@@ -37,6 +37,51 @@
 #include "src/shared/tty.h"
 #include "src/shared/hci.h"
 
+/*
+ * Map a baud rate to the matching termios speed constant.
+ *
+ * The termios speed passed to tcsetattr() has to be a Bxxxx constant, not
+ * the plain number: the kernel decodes CBAUD from it and a raw value (for
+ * example 1500000) leaves CBAUD empty, so the port ends up programmed for
+ * 0 baud. Every Bxxxx constant fits in 14 bits, which is what the range
+ * check below relies on.
+ */
+static speed_t baud_to_speed(unsigned int baud)
+{
+	switch (baud) {
+	case 9600:
+		return B9600;
+	case 19200:
+		return B19200;
+	case 38400:
+		return B38400;
+	case 57600:
+		return B57600;
+	case 115200:
+		return B115200;
+	case 230400:
+		return B230400;
+	case 460800:
+		return B460800;
+	case 500000:
+		return B500000;
+	case 576000:
+		return B576000;
+	case 921600:
+		return B921600;
+	case 1000000:
+		return B1000000;
+	case 1152000:
+		return B1152000;
+	case 1500000:
+		return B1500000;
+	case 2000000:
+		return B2000000;
+	}
+
+	return B0;
+}
+
 static int open_serial(const char *path, unsigned int speed, bool flowctl)
 {
 	struct termios ti;
@@ -64,7 +109,22 @@
